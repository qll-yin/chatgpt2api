# ============================================
# ChatGPT2API 环境变量配置示例
# ============================================

# ============================================
# 认证密钥（必填）
# ============================================
CHATGPT2API_AUTH_KEY=your_secret_key_here

# ============================================
# 端口（宿主机映射到容器 80）
# ============================================
CHATGPT2API_PORT=3000
# docker-compose.local.yml（SQLite 版）用的是这个端口
# CHATGPT2API_LOCAL_PORT=8000

# ============================================
# 存储后端配置
# ============================================

# 存储后端类型（可选值: json, sqlite, postgres）
# 默认: postgres（compose 里已内置 db 服务，开箱即用）
STORAGE_BACKEND=postgres

# ============================================
# 数据库配置（当 STORAGE_BACKEND=postgres时使用）
# ============================================
POSTGRES_USER=chatgpt2api
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=chatgpt2api