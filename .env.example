# ============================================
# ChatGPT2API 环境变量配置示例
# ============================================
#
# 用法：cp .env.example .env，然后改 .env —— **docker-compose.yml 不用动**。
#       compose 里所有可调项都走 ${VAR:-默认值}，改 .env 立即生效。
#       .env 已在 .gitignore 里，不会进版本库。
#
# ⚠️ 只有第一次部署（或换机器）才需要改这里；
#    之后 git pull 升级不会覆盖 .env。

# ============================================
# 认证密钥（必填）
# ============================================
CHATGPT2API_AUTH_KEY=your_secret_key_here

# 基础 URL（可选，用于生成图片 URL）
# CHATGPT2API_BASE_URL=https://your-domain.com

# ============================================
# 端口（宿主机映射到容器 80）
# ============================================
CHATGPT2API_PORT=3000
# docker-compose.local.yml（SQLite 版）用的是这个端口
# CHATGPT2API_LOCAL_PORT=8000

# ============================================
# 存储后端配置
# ============================================

# 存储后端类型（可选值: json, sqlite, postgres, git）
# 默认: postgres（compose 里已内置 db 服务，开箱即用）
STORAGE_BACKEND=postgres

# ============================================
# 数据库配置（当 STORAGE_BACKEND=sqlite/postgres 时使用）
# ============================================

# ── compose 内置的 Postgres ──
# 下面三个变量同时被 docker-compose.yml 的 DATABASE_URL 引用，
# 所以**只改这里一处**，连接串和数据库容器两边自动一致。
# ⚠️ 上线前务必把密码换掉（默认值是弱密码）。
# ⚠️ 密码里别用 @ : / 这几个字符（连接串里要转义）。
POSTGRES_USER=chatgpt2api
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=chatgpt2api

# 需要连**外部**数据库时，不要改这个文件 ——
# 建一个 docker-compose.override.yml（不进版本库），写：
#   services:
#     app:
#       environment:
#         DATABASE_URL: postgresql://user:password@host:5432/dbname
# compose 会自动合并 override 文件。

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 示例（不指定时自动使用 data/accounts.db）
# DATABASE_URL=sqlite:///app/data/accounts.db

# ============================================
# Git 仓库配置（当 STORAGE_BACKEND=git 时使用）
# ============================================

# Git 仓库地址（必填）
# GIT_REPO_URL=https://github.com/your-username/your-private-repo.git
